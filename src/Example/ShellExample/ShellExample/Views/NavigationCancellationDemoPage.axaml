<Page xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ShellExample.Views.NavigationCancellationDemoPage"
             NavigationBar.Header="Navigation Cancellation Demo">
    <NavigationBar.HeaderIcon>
        <i:Icon Value="fa-solid fa-flask" />
    </NavigationBar.HeaderIcon>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <TextBlock Text="Navigation Cancellation Demo"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="This page demonstrates navigation cancellation scenarios where target pages cancel their own navigation during InitializeAsync."
                       FontSize="16"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <!-- NavigateAsync Cancellation Demo -->
            <Border CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="1. NavigateAsync Cancellation"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14">
                        <Run Text="This scenario demonstrates a page that cancels its own navigation during InitializeAsync using " />
                        <Run Text="Navigator.BackAsync()" FontWeight="Bold" />
                        <Run Text=". The target page should never be visible." />
                    </TextBlock>

                    <TextBlock Text="Expected behavior:"
                               FontWeight="SemiBold"
                               FontSize="14" />

                    <StackPanel Margin="20,0,0,0" Spacing="5">
                        <TextBlock Text="• Navigation starts to NavigateCancelledPage" FontSize="12" />
                        <TextBlock Text="• Target page calls Navigator.BackAsync() in InitializeAsync" FontSize="12" />
                        <TextBlock Text="• Navigation is cancelled and you return to this page" FontSize="12" />
                        <TextBlock Text="• Target page is never displayed" FontSize="12" />
                    </StackPanel>

                    <Button Content="Test NavigateAsync Cancellation"
                            HorizontalAlignment="Center"
                            Click="NavigateClick"
                            Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- NavigateAndWaitAsync Cancellation Demo -->
            <Border CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="2. NavigateAndWaitAsync Cancellation"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14">
                        <Run Text="This scenario demonstrates nested " />
                        <Run Text="NavigateAndWaitAsync" FontWeight="Bold" />
                        <Run Text=" cancellation where a page navigates to another page that cancels the entire chain." />
                    </TextBlock>

                    <TextBlock Text="Expected behavior:"
                               FontWeight="SemiBold"
                               FontSize="14" />

                    <StackPanel Margin="20,0,0,0" Spacing="5">
                        <TextBlock Text="• Navigation starts to NavigateAndWaitCancelledPage" FontSize="12" />
                        <TextBlock Text="• Target page calls NavigateAndWaitAsync to CancellationHelperPage" FontSize="12" />
                        <TextBlock Text="• Helper page calls Navigator.BackAsync() in InitializeAsync" FontSize="12" />
                        <TextBlock Text="• Entire navigation chain is cancelled" FontSize="12" />
                        <TextBlock Text="• You return to this page, neither target page is displayed" FontSize="12" />
                    </StackPanel>

                    <Button Content="Test NavigateAndWaitAsync Cancellation"
                            HorizontalAlignment="Center"
                            Click="NavigateAndWaitClick"
                            Margin="0,10,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>